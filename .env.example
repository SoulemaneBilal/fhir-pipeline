# ==============================================================================
# Modèle de variables d'environnement — fhir-pipeline (Togo)
# Copier ce fichier vers .env et adapter les valeurs locales si nécessaire.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environnement général et exécution
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Graine aléatoire fixe garantissant la reproductibilité au bit près (AGENT.md §2)
RANDOM_SEED=42

# ------------------------------------------------------------------------------
# 2. Base de données PostgreSQL (Serveur Docker commun HAPI FHIR & OMOP CDM)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pipeline_admin
POSTGRES_PASSWORD=pipeline_secure_password_dev

# Base de données HAPI FHIR JPA
HAPI_FHIR_DB=hapi_fhir

# Base de données OMOP CDM 5.4
OMOP_DB=omop_cdm
OMOP_CDM_SCHEMA=cdm54
OMOP_VOCAB_SCHEMA=vocab

# ------------------------------------------------------------------------------
# 3. Serveur HL7 FHIR R4 (HAPI FHIR JPA)
# ------------------------------------------------------------------------------
HAPI_FHIR_BASE_URL=http://localhost:8080/fhir
HAPI_FHIR_VERSION=4.0.1

# ------------------------------------------------------------------------------
# 4. Passerelle d'interopérabilité OpenHIE (OpenHIM)
# ------------------------------------------------------------------------------
# Flag CLI de médiation (D-06) : true = transit via OpenHIM, false = HAPI direct
USE_OPENHIM=true
OPENHIM_CORE_URL=https://localhost:8080
OPENHIM_API_PORT=5001
OPENHIM_CONSOLE_URL=https://localhost:9000
OPENHIM_ROOT_USER=root@openhim.org
OPENHIM_ROOT_PASSWORD=openhim_secure_password_dev

# ------------------------------------------------------------------------------
# 5. Moteur SQL Analytique in-process (DuckDB)
# ------------------------------------------------------------------------------
DUCKDB_DATABASE_PATH=data/analytics.duckdb
DUCKDB_THREADS=4
DUCKDB_MEMORY_LIMIT=2GB

# ------------------------------------------------------------------------------
# 6. Source externe de démonstration publique DHIS2
# ------------------------------------------------------------------------------
DHIS2_BASE_URL=https://play.dhis2.org/demo
DHIS2_API_VERSION=40
DHIS2_USERNAME=admin
DHIS2_PASSWORD=district

# ------------------------------------------------------------------------------
# 7. Sécurité, Pseudonymisation et Espace de Noms Déterministe (UUID v5)
# ------------------------------------------------------------------------------
# Sel cryptographique pour le hachage HMAC-SHA256 des identifiants patients exportés
PSEUDONYMIZATION_SALT=dev_insecure_salt_replace_in_production_32bytes_min

# Espace de noms UUID v5 fixe pour le calcul déterministe des identifiants FHIR
UUID_NAMESPACE_PATIENT=6ba7b810-9dad-11d1-80b4-00c04fd430c8
UUID_NAMESPACE_ENCOUNTER=6ba7b811-9dad-11d1-80b4-00c04fd430c8
UUID_NAMESPACE_CONDITION=6ba7b812-9dad-11d1-80b4-00c04fd430c8
UUID_NAMESPACE_OBSERVATION=6ba7b813-9dad-11d1-80b4-00c04fd430c8
